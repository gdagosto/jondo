<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HeroesPackageDirectory Condition="'$(HeroesPackageDirectory)' == ''">$(MSBuildProjectDirectory)/../server-mods/heroes</HeroesPackageDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jondo.Unity.Contract\Jondo.Unity.Contract.csproj" Private="false" />
  </ItemGroup>

  <Target Name="StageServerMod" AfterTargets="Build" Condition="'$(StageServerMod)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/manifest.json"
          DestinationFolder="$(HeroesPackageDirectory)" SkipUnchangedFiles="true" />
  </Target>
</Project>
